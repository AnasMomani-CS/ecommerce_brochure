<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fresh Produce Delivery - Mobile App Brochure</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --color-primary-dark: #2D9B6F;
            --color-primary: #4CAF50;
            --color-accent-teal: #1DB89E;
            --color-accent-light: #5DDFCC;
            --color-text-dark: #1a1a1a;
            --color-text-light: #666;
            --color-bg-light: #FAFAF8;
            --color-bg-white: #FFFFFF;
            --color-border: #E8E8E5;
            --spacing-xs: 8px;
            --spacing-sm: 16px;
            --spacing-md: 24px;
            --spacing-lg: 40px;
            --spacing-xl: 64px;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            line-height: 1.6;
            color: var(--color-text-dark);
            background-color: var(--color-bg-white);
        }

        /* Typography */
        h1 {
            font-size: 48px;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: var(--spacing-md);
            letter-spacing: -0.5px;
        }

        h2 {
            font-size: 36px;
            font-weight: 700;
            line-height: 1.3;
            margin-bottom: var(--spacing-md);
            letter-spacing: -0.3px;
        }

        h3 {
            font-size: 24px;
            font-weight: 600;
            line-height: 1.4;
            margin-bottom: var(--spacing-sm);
        }

        p {
            font-size: 16px;
            line-height: 1.7;
            color: var(--color-text-light);
            max-width: 65ch;
        }

        /* Utility Classes */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 var(--spacing-lg);
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-accent-teal) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Header & Navigation */
        header {
            background: var(--color-bg-white);
            border-bottom: 1px solid var(--color-border);
            padding: var(--spacing-sm) 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 20px;
            font-weight: 700;
            color: var(--color-primary);
            letter-spacing: -0.5px;
        }

        nav a {
            color: var(--color-text-dark);
            text-decoration: none;
            font-size: 14px;
            margin-left: var(--spacing-lg);
            transition: color 0.3s ease;
        }

        nav a:hover {
            color: var(--color-primary);
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, #F5FFF8 0%, #F0F9F7 100%);
            padding: var(--spacing-xl) 0;
            overflow: hidden;
        }

        .hero-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-xl);
            align-items: center;
        }

        .hero-text h1 {
            font-size: 56px;
            margin-bottom: var(--spacing-md);
        }

        .hero-text p {
            font-size: 18px;
            margin-bottom: var(--spacing-lg);
            color: var(--color-text-light);
        }

        .cta-button {
            display: inline-block;
            padding: 16px 40px;
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent-teal) 100%);
            color: white;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(76, 175, 80, 0.25);
        }

        .hero-image {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .phone-frame {
            width: 300px;
            height: 600px;
            background: var(--color-bg-white);
            border-radius: 40px;
            padding: 12px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
            border: 8px solid var(--color-bg-white);
            overflow: hidden;
            position: relative;
        }

        .phone-frame::before {
            content: '';
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 150px;
            height: 25px;
            background: var(--color-text-dark);
            border-radius: 0 0 30px 30px;
            z-index: 10;
        }

        .phone-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 32px;
            display: block;
        }

        /* Sections */
        section {
            padding: var(--spacing-xl) 0;
        }

        section.light {
            background-color: var(--color-bg-light);
        }

        /* Features Grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--spacing-lg);
            margin-top: var(--spacing-xl);
        }

        .feature-card {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--spacing-lg);
            align-items: center;
            background: var(--color-bg-white);
            padding: var(--spacing-lg);
            border-radius: 20px;
            border: 1px solid var(--color-border);
            transition: border-color 0.3s ease;
        }

        .feature-card:hover {
            border-color: var(--color-primary);
        }

        .feature-card.reverse {
            direction: rtl;
        }

        .feature-card.reverse > * {
            direction: ltr;
        }

        .feature-card img {
            width: 100%;
            height: auto;
            border-radius: 16px;
        }

        .feature-card h3 {
            color: var(--color-text-dark);
            margin-bottom: var(--spacing-sm);
        }

        .feature-card p {
            color: var(--color-text-light);
            margin-bottom: 0;
        }

        /* Highlights Section */
        .highlights {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--spacing-lg);
            margin-top: var(--spacing-xl);
        }

        .highlight-item {
            text-align: center;
            padding: var(--spacing-lg);
        }

        .highlight-icon {
            font-size: 48px;
            margin-bottom: var(--spacing-sm);
        }

        .highlight-item h3 {
            margin-bottom: var(--spacing-sm);
            color: var(--color-primary-dark);
        }

        .highlight-item p {
            font-size: 14px;
            margin: 0 auto;
        }

        /* Screenshots Gallery */
        .screenshots-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--spacing-md);
            margin-top: var(--spacing-xl);
        }

        .screenshot-item {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

        .screenshot-item:hover {
            transform: translateY(-5px);
        }

        .screenshot-item img {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 20px;
        }

        .screenshot-label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
            color: white;
            padding: var(--spacing-md);
            border-radius: 0 0 20px 20px;
        }

        .screenshot-label h4 {
            font-size: 16px;
            font-weight: 600;
            margin: 0;
        }

        .screenshot-label p {
            font-size: 12px;
            color: rgba(255,255,255,0.8);
            margin: 4px 0 0 0;
        }

        /* Flow Section */
        .flow-steps {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: var(--spacing-md);
            margin-top: var(--spacing-xl);
        }

        .flow-step {
            position: relative;
            text-align: center;
            padding: var(--spacing-md);
            background: var(--color-bg-white);
            border-radius: 16px;
            border: 1px solid var(--color-border);
        }

        .step-number {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent-teal) 100%);
            color: white;
            border-radius: 50%;
            font-weight: 700;
            font-size: 18px;
            margin-bottom: var(--spacing-sm);
        }

        .flow-step h4 {
            font-size: 14px;
            margin-bottom: var(--spacing-sm);
            color: var(--color-text-dark);
        }

        .flow-step p {
            font-size: 12px;
            color: var(--color-text-light);
            margin: 0;
        }

        .flow-step::after {
            content: '→';
            position: absolute;
            right: -28px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 24px;
            color: var(--color-primary);
            font-weight: 300;
        }

        .flow-step:last-child::after {
            display: none;
        }

        /* CTA Section */
        .cta-section {
            background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-accent-teal) 100%);
            padding: var(--spacing-xl) 0;
            text-align: center;
            border-radius: 24px;
            color: white;
        }

        .cta-section h2 {
            color: white;
            margin-bottom: var(--spacing-md);
        }

        .cta-section p {
            color: rgba(255, 255, 255, 0.95);
            font-size: 18px;
            margin-bottom: var(--spacing-lg);
        }

        .cta-button-light {
            display: inline-block;
            padding: 16px 40px;
            background: white;
            color: var(--color-primary);
            text-decoration: none;
            border-radius: 12px;
            font-weight: 600;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        .cta-button-light:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
        }

        /* Footer */
        footer {
            background: var(--color-text-dark);
            color: rgba(255, 255, 255, 0.7);
            padding: var(--spacing-lg) 0;
            text-align: center;
            font-size: 14px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            h1 {
                font-size: 36px;
            }

            h2 {
                font-size: 28px;
            }

            .container {
                padding: 0 var(--spacing-md);
            }

            .hero-content,
            .feature-card,
            .features-grid,
            .highlights,
            .screenshots-grid,
            .flow-steps {
                grid-template-columns: 1fr;
            }

            .flow-steps {
                gap: var(--spacing-lg);
            }

            .flow-step::after {
                display: none;
            }

            .flow-step::before {
                content: '↓';
                display: block;
                font-size: 20px;
                color: var(--color-primary);
                margin-top: var(--spacing-md);
            }

            .flow-step:last-child::before {
                display: none;
            }

            nav {
                display: none;
            }

            section {
                padding: var(--spacing-lg) 0;
            }
        }

        @media print {
            header {
                position: static;
            }

            .cta-button, .cta-button-light {
                border: 2px solid var(--color-primary);
            }

            section {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container">
            <div class="header-content">
                <div class="logo">Fresh Produce Delivery</div>
                <nav>
                    <a href="#features">Features</a>
                    <a href="#how-it-works">How It Works</a>
                    <a href="#download">Download</a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1>Fresh Produce, Delivered Daily to Your Door</h1>
                    <p>Discover a smarter way to shop for fruits, vegetables, and fresh groceries. Browse our curated selection, select your preferred weights, and have everything delivered to your location—all from your phone.</p>
                    <button class="cta-button">Download Now</button>
                </div>
                <div class="hero-image">
                    <div class="phone-frame">
                        <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251738/SplashScreen.png" alt="App splash screen">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Key Highlights -->
    <section class="light">
        <div class="container">
            <h2 style="text-align: center; margin-bottom: var(--spacing-xl);">Why Choose Fresh Produce Delivery</h2>
            <div class="highlights">
                <div class="highlight-item">
                    <div class="highlight-icon">🥗</div>
                    <h3>Freshest Selection</h3>
                    <p>Handpicked produce harvested daily, delivered at peak freshness for quality you can taste.</p>
                </div>
                <div class="highlight-item">
                    <div class="highlight-icon">📍</div>
                    <h3>Fast Delivery</h3>
                    <p>Order whenever you want and get your produce delivered to your location quickly and reliably.</p>
                </div>
                <div class="highlight-item">
                    <div class="highlight-icon">💚</div>
                    <h3>Save Your Favorites</h3>
                    <p>Mark items you love to quickly add them to your cart next time you shop.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features">
        <div class="container">
            <h2>Core Features</h2>
            
            <div class="features-grid">
                <!-- Feature 1: Browse & Explore -->
                <div class="feature-card">
                    <div>
                        <h3>Browse & Explore</h3>
                        <p>Explore fresh fruits, vegetables, and grocery items organized by category. See detailed product information, pricing, and weight options. Search for exactly what you need or discover new items with our featured selection.</p>
                    </div>
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251739/uwpaxdvitjdtxv7jjudt.png" alt="Browse products screen">
                </div>

                <!-- Feature 2: Smart Selection -->
                <div class="feature-card reverse">
                    <div>
                        <h3>Choose Your Perfect Weight</h3>
                        <p>Select from multiple weight options for each product. Whether you need a small amount or stocking up for the week, our flexible weight selections ensure you get exactly what you need without waste.</p>
                    </div>
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251739/jh0gvmkeouoblbeugctm.png" alt="Product selection screen">
                </div>

                <!-- Feature 3: Favorites -->
                <div class="feature-card">
                    <div>
                        <h3>Save Your Favorites</h3>
                        <p>Build a personalized list of your go-to products. Quick access to your favorite items makes reordering faster and easier. Great for your regular produce essentials.</p>
                    </div>
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251738/ar6nzndclcgyi7xeftgj.png" alt="Favorites screen">
                </div>

                <!-- Feature 4: Smart Cart -->
                <div class="feature-card reverse">
                    <div>
                        <h3>Manage Your Cart</h3>
                        <p>Add, remove, or adjust quantities right from your cart. See real-time pricing with our special offers and discounts. Everything is organized and easy to review before checkout.</p>
                    </div>
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251739/lbljc3gfo7hexrwo7av7.png" alt="Shopping cart screen">
                </div>
            </div>
        </div>
    </section>

    <!-- Complete User Experience -->
    <section class="light">
        <div class="container">
            <h2>Complete User Experience</h2>
            
            <div class="screenshots-grid">
                <div class="screenshot-item">
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251738/a1lvlsmbb7nex9tvuxt9.png" alt="Login screen">
                    <div class="screenshot-label">
                        <h4>Secure Login</h4>
                        <p>Easy access to your account</p>
                    </div>
                </div>

                <div class="screenshot-item">
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251738/amxpfr53s9ey69psvfma.png" alt="Sign up screen">
                    <div class="screenshot-label">
                        <h4>Quick Registration</h4>
                        <p>Create your account in minutes</p>
                    </div>
                </div>

                <div class="screenshot-item">
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251739/gmr1k4l29w3c2c36tdb0.png" alt="User profile screen">
                    <div class="screenshot-label">
                        <h4>Your Profile</h4>
                        <p>Manage your personal information</p>
                    </div>
                </div>

                <div class="screenshot-item">
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251739/uwpaxdvitjdtxv7jjudt.png" alt="Home screen">
                    <div class="screenshot-label">
                        <h4>Home Dashboard</h4>
                        <p>Personalized shopping experience</p>
                    </div>
                </div>

                <div class="screenshot-item">
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251739/jh0gvmkeouoblbeugctm.png" alt="Product details">
                    <div class="screenshot-label">
                        <h4>Product Details</h4>
                        <p>In-depth information and options</p>
                    </div>
                </div>

                <div class="screenshot-item">
                    <img src="https://res.cloudinary.com/dlcznjfy2/image/upload/v1789251738/uus0auoyajyikh61esxq.png" alt="Checkout">
                    <div class="screenshot-label">
                        <h4>Checkout</h4>
                        <p>Simple, secure payment process</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section id="how-it-works">
        <div class="container">
            <h2>How It Works</h2>
            <div class="flow-steps">
                <div class="flow-step">
                    <div class="step-number">1</div>
                    <h4>Sign Up</h4>
                    <p>Create your account in seconds with your email or existing credentials.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">2</div>
                    <h4>Browse</h4>
                    <p>Explore fresh produce items organized by category or search for specific products.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">3</div>
                    <h4>Select</h4>
                    <p>Choose your preferred weight and quantity. Add items to cart or save as favorites.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">4</div>
                    <h4>Checkout</h4>
                    <p>Review your order, apply available discounts, and select your payment method.</p>
                </div>
                <div class="flow-step">
                    <div class="step-number">5</div>
                    <h4>Delivered</h4>
                    <p>Your fresh produce is delivered to your specified location the same day.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section id="download" class="cta-section">
        <div class="container">
            <h2>Ready for Fresh Produce Delivered Daily?</h2>
            <p>Download the app today and start enjoying the freshest selection of fruits, vegetables, and groceries delivered right to your door.</p>
            <button class="cta-button-light">Download Now</button>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container">
            <p>&copy; 2026 Fresh Produce Delivery. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>